{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/schemas/bestiary-data.schema.json",
  "title": "Seven Governors Bestiary of Archetypes",
  "description": "Strict schema for the deterministic bestiary-data.json artifact generated by scripts/build-bestiary.mjs. Missing data is explicit null; keys are never omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "build",
    "sources",
    "summary",
    "archetypes",
    "relationships",
    "commutationPairs",
    "projectionGaps"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "releaseId": {
      "type": "string",
      "pattern": "^seven-governors-integrated-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "toolVersion"],
      "properties": {
        "tool": { "const": "build-bestiary.mjs" },
        "toolVersion": { "const": "1.0.0" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetypeCount", "byCategory"],
      "properties": {
        "archetypeCount": { "type": "integer", "minimum": 595 },
        "byCategory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scaleState",
            "scaleFamily",
            "governorOffice",
            "canonicalProfile",
            "mutationOperator",
            "modalCycle",
            "candidateExtension"
          ],
          "properties": {
            "scaleState": { "const": 462 },
            "scaleFamily": { "const": 38 },
            "governorOffice": { "const": 7 },
            "canonicalProfile": { "const": 7 },
            "mutationOperator": { "const": 15 },
            "modalCycle": { "const": 66 },
            "candidateExtension": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 595,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/scaleState" },
          { "$ref": "#/$defs/scaleFamily" },
          { "$ref": "#/$defs/governorOffice" },
          { "$ref": "#/$defs/canonicalProfile" },
          { "$ref": "#/$defs/mutationOperator" },
          { "$ref": "#/$defs/modalCycle" },
          { "$ref": "#/$defs/candidateExtension" }
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "commutationPairs": {
      "type": "array",
      "minItems": 91,
      "maxItems": 91,
      "items": { "$ref": "#/$defs/commutationPair" }
    },
    "projectionGaps": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/projectionGap" }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrativeKind", "text", "model", "sha256"],
      "properties": {
        "narrativeKind": { "enum": ["deterministic_template", "ai_generated"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "model": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] }
      }
    },
    "scaleState": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "nodeId", "forte", "pitchSetMask", "pitchSetPcs", "bitLabel",
        "bitReverseLabel", "role", "fineRole", "tier", "office",
        "officeIndex", "officeBearing", "chirality", "orientation",
        "assignmentStatus", "resolutionClass", "parents", "incomingCount",
        "outgoingCount", "canonicalProfileId", "compiledProfileId"
      ],
      "properties": {
        "kind": { "const": "scaleState" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "nodeId": { "type": "integer" },
        "forte": { "type": ["string", "null"] },
        "pitchSetMask": { "type": ["integer", "null"], "minimum": 0, "maximum": 4095 },
        "pitchSetPcs": {
          "type": ["array", "null"],
          "maxItems": 7,
          "items": { "type": "integer", "minimum": 0, "maximum": 11 }
        },
        "bitLabel": { "type": ["string", "null"], "pattern": "^b[01]{12}$" },
        "bitReverseLabel": { "type": ["string", "null"], "pattern": "^b[01]{12}$" },
        "role": { "enum": ["anchor", "satellite", "boundary"] },
        "fineRole": { "type": ["string", "null"] },
        "tier": { "type": ["string", "null"] },
        "office": { "type": ["string", "null"] },
        "officeIndex": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
        "officeBearing": { "type": "boolean" },
        "chirality": { "type": ["string", "null"], "enum": ["achiral", "chiral", null] },
        "orientation": { "type": ["string", "null"] },
        "assignmentStatus": { "type": "string" },
        "resolutionClass": { "type": ["string", "null"] },
        "parents": { "type": "array", "items": { "type": "integer" } },
        "incomingCount": { "type": "integer" },
        "outgoingCount": { "type": "integer" },
        "canonicalProfileId": { "type": ["string", "null"] },
        "compiledProfileId": { "type": ["string", "null"] }
      }
    },
    "scaleFamily": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "forte", "stateCount", "modalOrientationCount", "chirality",
        "registeredBeforeCompletion", "missingBeforeCompletion", "zPartner",
        "memberStateIds"
      ],
      "properties": {
        "kind": { "const": "scaleFamily" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "forte": { "type": "string", "pattern": "^[0-9]+(-[A-Z]?[0-9]+)?$" },
        "stateCount": { "type": "integer", "minimum": 1, "maximum": 14 },
        "modalOrientationCount": { "type": "integer" },
        "chirality": { "type": ["string", "null"], "enum": ["achiral", "chiral", null] },
        "registeredBeforeCompletion": { "type": "integer" },
        "missingBeforeCompletion": { "type": "integer" },
        "zPartner": { "type": ["string", "null"] },
        "memberStateIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        }
      }
    },
    "governorOffice": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "office", "officeIndex", "color", "profileId", "stateCount", "symbol"
      ],
      "properties": {
        "kind": { "const": "governorOffice" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "office": { "type": "string" },
        "officeIndex": { "type": "integer", "minimum": 0, "maximum": 6 },
        "color": { "type": ["string", "null"], "pattern": "^#[0-9A-F]{6}$" },
        "profileId": { "type": ["string", "null"] },
        "stateCount": { "type": "integer" },
        "symbol": { "type": ["string", "null"] }
      }
    },
    "canonicalProfile": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "profileId", "profileVersion", "office", "officeIndex", "type",
        "canonicalIdentity", "photonic", "intrinsicFingerprint",
        "landformReferences", "unresolvedScopeBindings"
      ],
      "properties": {
        "kind": { "const": "canonicalProfile" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "profileId": { "type": "string", "pattern": "^profile:[a-z]+:v" },
        "profileVersion": { "type": "string" },
        "office": { "type": "string" },
        "officeIndex": { "type": "integer", "minimum": 0, "maximum": 6 },
        "type": { "type": "string" },
        "canonicalIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stateId", "stateName", "mode", "forteFamily", "pitchMask",
            "pitchSet", "anchorTier", "chirality", "assignmentStatus"
          ],
          "properties": {
            "stateId": { "type": "integer" },
            "stateName": { "type": "string" },
            "mode": { "type": "string" },
            "forteFamily": { "type": "string" },
            "pitchMask": { "type": "string" },
            "pitchSet": { "type": "string" },
            "anchorTier": { "type": "string" },
            "chirality": { "type": "string" },
            "assignmentStatus": { "type": "string" }
          }
        },
        "photonic": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["photonicId", "wavelengthNm", "color"],
          "properties": {
            "photonicId": { "type": "string" },
            "wavelengthNm": { "type": "integer" },
            "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
          }
        },
        "intrinsicFingerprint": { "type": "string" },
        "landformReferences": { "type": "integer" },
        "unresolvedScopeBindings": { "type": "integer" }
      }
    },
    "mutationOperator": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "operatorId", "notation", "operatorClass", "degree",
        "degreeGovernor", "direction", "deltaSemitones", "domainRule",
        "action", "inverseOperatorId", "conjugateOperatorId", "partial",
        "status", "applicationCount", "domainSize", "imageSize",
        "structuralSupportCount", "fieldSupportCount", "projectionGapId",
        "semanticOperatorId"
      ],
      "properties": {
        "kind": { "const": "mutationOperator" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "operatorId": { "type": "string", "pattern": "^(M|R[1-7]|L[1-7])$" },
        "notation": { "type": "string" },
        "operatorClass": {
          "enum": ["modal_re_rooting", "root_phase", "fixed_degree_shift"]
        },
        "degree": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
        "degreeGovernor": { "type": ["string", "null"] },
        "direction": { "enum": ["successor", "raise", "lower"] },
        "deltaSemitones": { "type": ["integer", "null"] },
        "domainRule": { "type": "string" },
        "action": { "type": "string" },
        "inverseOperatorId": { "type": "string", "pattern": "^(M(\\^6)?|R[1-7]|L[1-7])$" },
        "conjugateOperatorId": { "type": "string", "pattern": "^(M(\\^6)?|R[1-7]|L[1-7])$" },
        "partial": { "type": "boolean" },
        "status": { "type": "string" },
        "applicationCount": { "type": "integer" },
        "domainSize": { "type": "integer" },
        "imageSize": { "type": "integer" },
        "structuralSupportCount": { "type": "integer" },
        "fieldSupportCount": { "type": "integer" },
        "projectionGapId": { "type": "string", "pattern": "^(M|R[1-7]|L[1-7])$" },
        "semanticOperatorId": { "type": ["string", "null"] }
      }
    },
    "modalCycle": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "cycleId", "representativeStateId", "cycleLength", "forte", "role",
        "fineRole", "tier", "orientation", "chirality", "officeBearing",
        "officeSequence", "officeDeltaSequence", "memberStateIds"
      ],
      "properties": {
        "kind": { "const": "modalCycle" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "enum": ["admitted", "proposed"] },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "cycleId": { "type": "string", "pattern": "^modal-cycle:[0-9]+$" },
        "representativeStateId": { "type": "integer" },
        "cycleLength": { "const": 7 },
        "forte": { "type": "string" },
        "role": { "type": "string" },
        "fineRole": { "type": "string" },
        "tier": { "type": "string" },
        "orientation": { "type": ["string", "null"] },
        "chirality": { "type": ["string", "null"] },
        "officeBearing": { "type": "boolean" },
        "officeSequence": {
          "type": ["array", "null"],
          "minItems": 7,
          "maxItems": 7,
          "items": { "type": "string" }
        },
        "officeDeltaSequence": {
          "type": ["array", "null"],
          "minItems": 7,
          "maxItems": 7,
          "items": { "type": "integer" }
        },
        "memberStateIds": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "type": "integer" }
        }
      }
    },
    "candidateExtension": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/common" }],
      "required": [
        "kind", "id", "name", "admission", "summary", "sourcePath",
        "scatterX", "scatterY",
        "extensionId", "category", "roadmapRef", "proposedInvariants"
      ],
      "properties": {
        "kind": { "const": "candidateExtension" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "admission": { "const": "proposed" },
        "summary": { "$ref": "#/$defs/summary" },
        "sourcePath": { "type": "string" },
        "scatterX": { "type": "number" },
        "scatterY": { "type": "number" },
        "extensionId": { "type": "string" },
        "category": { "enum": ["court", "phenomena", "thermodynamic"] },
        "roadmapRef": { "type": "string" },
        "proposedInvariants": {
          "type": "array",
          "items": { "type": "string", "pattern": "^INV-[A-Z]+-[0-9]{3}$" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source", "target", "type", "governing", "directed", "mode",
        "mutation", "degree", "hamming", "selected", "eligible", "provenance"
      ],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "integer" },
        "target": { "type": "integer" },
        "type": { "type": "string" },
        "governing": { "type": "boolean" },
        "directed": { "type": "boolean" },
        "mode": { "type": ["string", "null"] },
        "mutation": { "type": ["string", "null"] },
        "degree": { "type": ["integer", "null"] },
        "hamming": { "type": ["integer", "null"] },
        "selected": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "provenance": { "type": "string" }
      }
    },
    "commutationPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorA", "operatorB", "sourceStatesTested", "aThenBDefined",
        "bThenADefined", "bothDefined", "equalWhenBothDefined",
        "unequalWhenBothDefined", "domainAsymmetry", "neitherDefined",
        "classification"
      ],
      "properties": {
        "operatorA": { "type": "string" },
        "operatorB": { "type": "string" },
        "sourceStatesTested": { "type": "integer" },
        "aThenBDefined": { "type": "integer" },
        "bThenADefined": { "type": "integer" },
        "bothDefined": { "type": "integer" },
        "equalWhenBothDefined": { "type": "integer" },
        "unequalWhenBothDefined": { "type": "integer" },
        "domainAsymmetry": { "type": "integer" },
        "neitherDefined": { "type": "integer" },
        "classification": {
          "enum": ["weak_common_domain_commutation", "strong_partial_commutation"]
        }
      }
    },
    "projectionGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorId", "formalApplications", "structuralProjection",
        "fieldProjection", "unionProjection", "unprojectedApplications",
        "unionCoverageRate", "interpretation"
      ],
      "properties": {
        "operatorId": { "type": "string", "pattern": "^(M|R[1-7]|L[1-7])$" },
        "formalApplications": { "type": "integer" },
        "structuralProjection": { "type": "integer" },
        "fieldProjection": { "type": "integer" },
        "unionProjection": { "type": "integer" },
        "unprojectedApplications": { "type": "integer" },
        "unionCoverageRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.000001
        },
        "interpretation": { "type": "string" }
      }
    }
  }
}
