---
import "../styles/global.css";
import { bestiary, kindLabels } from "../lib/bestiary";

interface Props {
  title?: string;
}

const { title = "Seven Governors — Bestiary of Archetypes" } = Astro.props;
const counts = bestiary.summary.byCategory;
const kindOrder = [
  "scaleState",
  "scaleFamily",
  "governorOffice",
  "canonicalProfile",
  "mutationOperator",
  "modalCycle",
  "candidateExtension",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%230d0d0d'/%3E%3Ctext x='8' y='12' font-size='11' text-anchor='middle' fill='%238cf'%3E◇%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body class="min-h-screen bg-void text-frost antialiased">
    <header class="sticky top-0 z-20 border-b border-edge bg-void/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="text-sm font-semibold tracking-wider text-accent">
          BESTIARY OF ARCHETYPES
        </a>
        <div class="flex flex-wrap gap-1.5 text-[11px]">
          {kindOrder.map((kind) => (
            <span
              class="rounded-full border border-edge bg-raised px-2 py-0.5 text-muted"
              title={kindLabels[kind]}
            >
              {counts[kind] ?? 0} {kindLabels[kind].toLowerCase()}
            </span>
          ))}
        </div>
        <span
          class="ml-auto rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[11px] text-accent"
          title="Pinned source artifacts: 13"
        >
          {bestiary.releaseId}
        </span>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-edge">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-4 text-[11px] text-muted">
        <span>{bestiary.releaseId}</span>
        <span>{bestiary.archetypes.length} archetypes</span>
        <span>{bestiary.relationships.length} relationships</span>
        <span>{bestiary.commutationPairs.length} commutation pairs</span>
        <span>{bestiary.projectionGaps.length} projection gaps</span>
        <span class="ml-auto">{bestiary.build.tool} v{bestiary.build.toolVersion}</span>
      </div>
    </footer>
  </body>
</html>
