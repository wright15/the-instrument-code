---
interface Props {
  admission: "admitted" | "proposed";
}

const { admission } = Astro.props;
---

{
  admission === "admitted" ? (
    <span
      class="inline-flex items-center gap-1 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-emerald-300"
      title="Formally admitted to the active release"
    >
      <span class="size-1.5 rounded-full bg-emerald-400"></span>
      ADMITTED
    </span>
  ) : (
    <span
      class="inline-flex items-center gap-1 rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-amber-300"
      title="Proposed candidate extension — not part of the active system"
    >
      <span class="size-1.5 rounded-full bg-amber-400"></span>
      PROPOSED
    </span>
  )
}
