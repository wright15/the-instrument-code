---
import type { ScaleFamily } from "../../lib/bestiary";
import { archetypeHref, stateById, stateHref } from "../../lib/bestiary";
import DetailSection from "./DetailSection.astro";
import PitchSetDial from "../PitchSetDial.astro";

interface Props {
  archetype: ScaleFamily;
}

const { archetype } = Astro.props;
const members = archetype.memberStateIds
  .map((nodeId) => stateById(nodeId))
  .filter(Boolean);
const representative = members[0];
---

<div class="flex flex-col gap-4">
  {representative?.pitchSetPcs && representative.pitchSetMask !== null && (
    <DetailSection
      title="Pitch set"
      description={`Representative dial from root state ${representative.nodeId}.`}
    >
      <div class="flex justify-center">
        <PitchSetDial
          pcs={representative.pitchSetPcs}
          mask={representative.pitchSetMask}
          office={representative.office}
        />
      </div>
    </DetailSection>
  )}
  <DetailSection title="Identity">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-xs md:grid-cols-3">
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">forte</dt>
        <dd class="font-mono text-frost/90">{archetype.forte}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">states</dt>
        <dd class="font-mono text-frost/90">{archetype.stateCount}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">orientations</dt>
        <dd class="font-mono text-frost/90">{archetype.modalOrientationCount}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">chirality</dt>
        <dd class="font-mono text-frost/90">{archetype.chirality ?? "—"}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">registered before completion</dt>
        <dd class="font-mono text-frost/90">{archetype.registeredBeforeCompletion}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">missing before completion</dt>
        <dd class="font-mono text-frost/90">{archetype.missingBeforeCompletion}</dd>
      </div>
      {archetype.zPartner && (
        <div class="flex justify-between gap-2 border-b border-edge pb-1">
          <dt class="text-muted">Z-partner</dt>
          <dd>
            <a class="text-accent hover:underline" href={archetypeHref(`family:${archetype.zPartner}`)}>
              {archetype.zPartner}
            </a>
          </dd>
        </div>
      )}
    </dl>
  </DetailSection>

  <DetailSection
    title="Members"
    description={`All ${members.length} rooted states in the ${archetype.forte} set class.`}
  >
    <div class="flex flex-wrap gap-2">
      {members.map((member) => (
        <a
          class="rounded border border-edge bg-raised px-2 py-1 text-[11px] text-frost transition-colors hover:border-accent/50 hover:text-accent"
          href={stateHref(member.nodeId)}
        >
          <span class="font-mono">{member.nodeId}</span> {member.name}
        </a>
      ))}
    </div>
  </DetailSection>
</div>
