---
import type { CandidateExtension } from "../../lib/bestiary";
import DetailSection from "./DetailSection.astro";

interface Props {
  archetype: CandidateExtension;
}

const { archetype } = Astro.props;
---

<div class="flex flex-col gap-4">
  <div class="flex items-start gap-3 rounded-lg border border-amber-400/30 bg-amber-400/10 p-4">
    <span class="mt-0.5 text-amber-300">▷</span>
    <div>
      <div class="text-xs font-semibold text-amber-300">
        Proposed — not part of the active system
      </div>
      <p class="mt-1 text-xs leading-relaxed text-frost/70">
        This archetype is a candidate extension carried as roadmap material. It
        does not participate in release counts, commutation pairs, or projection
        gaps until formally admitted.
      </p>
    </div>
  </div>

  <DetailSection title="Identity">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-xs md:grid-cols-3">
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">category</dt>
        <dd class="font-mono text-frost/90">{archetype.category}</dd>
      </div>
      <div class="flex justify-between gap-2 border-b border-edge pb-1">
        <dt class="text-muted">roadmap</dt>
        <dd class="font-mono text-[10px] text-frost/90">{archetype.roadmapRef}</dd>
      </div>
    </dl>
  </DetailSection>

  <DetailSection
    title="Proposed invariants"
    description="Invariants proposed for admission with this extension."
  >
    <ul class="flex flex-col gap-1.5">
      {archetype.proposedInvariants.map((invariant) => (
        <li
          class="rounded border border-edge bg-raised px-2 py-1.5 font-mono text-[11px] text-frost/90"
        >
          {invariant}
        </li>
      ))}
    </ul>
  </DetailSection>
</div>
