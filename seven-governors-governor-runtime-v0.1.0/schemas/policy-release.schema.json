{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/governor-runtime/0.1.0/schemas/policy-release.schema.json",
  "title": "Governor Runtime PolicyRelease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "packageVersion",
    "policyVersion",
    "releaseId",
    "releaseDate",
    "releaseAdmission",
    "upstreamReleaseId",
    "sourceHashes",
    "sourceFingerprint",
    "featureCrosswalk",
    "constraintMarkers",
    "operations",
    "typedAspects",
    "bridgeRules",
    "activeAspectIds",
    "activeRuleIds",
    "policyFingerprint"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "packageName": { "const": "seven-governors-governor-runtime" },
    "packageVersion": { "const": "0.1.0" },
    "policyVersion": { "const": "0.1.0" },
    "releaseId": { "const": "governor-runtime:0.1.0" },
    "releaseDate": { "const": "2026-08-01" },
    "releaseAdmission": { "enum": ["proposed", "admitted"] },
    "upstreamReleaseId": { "const": "canonical-profile-registry:0.1.1" },
    "sourceHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "path", "sha256", "authority", "admission", "runtimeAuthority"],
        "properties": {
          "sourceId": { "$ref": "common.schema.json#/$defs/identifier" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "authority": {
            "enum": ["runtime_policy", "profile_registry", "candidate_companion"]
          },
          "admission": { "$ref": "common.schema.json#/$defs/admission" },
          "runtimeAuthority": { "type": "boolean" }
        }
      }
    },
    "sourceFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "featureCrosswalk": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "disposition", "ownerScope", "valueContractId"],
        "properties": {
          "featureId": { "$ref": "common.schema.json#/$defs/featureId" },
          "disposition": { "enum": ["reusable", "extended", "unresolved"] },
          "ownerScope": { "$ref": "common.schema.json#/$defs/ownerScope" },
          "valueContractId": { "$ref": "common.schema.json#/$defs/identifier" }
        }
      }
    },
    "constraintMarkers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["markerId", "legacyCompilerString", "kind"],
        "properties": {
          "markerId": { "$ref": "common.schema.json#/$defs/identifier" },
          "legacyCompilerString": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["compatibility_constraint", "derived_topology_mirror", "prohibition"] }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "typedAspects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "typed-aspect.schema.json" }
    },
    "bridgeRules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "bridge-rule.schema.json" }
    },
    "activeAspectIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "activeRuleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "policyFingerprint": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "inputDimensions",
        "inputUnits",
        "outputDimension",
        "outputUnit",
        "outputEpistemicClass",
        "formula",
        "constants",
        "requiredAssumptions",
        "provenance"
      ],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "enum": ["conversion", "derivation", "evaluation"] },
        "inputDimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/dimension" }
        },
        "inputUnits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/unit" }
        },
        "outputDimension": { "$ref": "common.schema.json#/$defs/dimension" },
        "outputUnit": { "$ref": "common.schema.json#/$defs/unit" },
        "outputEpistemicClass": {
          "enum": ["physically_derived", "physical_anchor_plus_normalization_convention"]
        },
        "formula": { "type": "string", "minLength": 1 },
        "constants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/identifier" },
              "value": { "type": "number" },
              "unit": { "enum": ["nm", "m", "Hz", "J", "eV", "one", "m_per_s", "J_s"] }
            }
          }
        },
        "requiredAssumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    }
  }
}
