{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanics-thermodynamics-registry.v1.0.0",
  "title": "Mechanics Thermodynamics Registry (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "admission_boundary", "framework", "elements", "guards"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "version", "status", "admission_status", "author", "layer", "physical_quantity_claim", "no_electromagnetic_equivalence", "no_thermodynamic_equivalence_with_kappa_court", "description", "architecture"],
      "properties": {
        "registry_id": { "const": "mechanics_thermodynamics_registry" },
        "version": { "const": "1.0.0" },
        "status": { "const": "proposed_canonization" },
        "admission_status": { "const": "proposed" },
        "author": { "type": "string", "minLength": 1 },
        "layer": { "const": 4 },
        "physical_quantity_claim": { "const": false },
        "no_electromagnetic_equivalence": { "const": true },
        "no_thermodynamic_equivalence_with_kappa_court": { "const": true },
        "description": { "type": "string", "minLength": 1 },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities_are", "split_by", "electric_bit", "magnetic_bit", "authored_game_mechanics_not_physics"],
          "properties": {
            "capabilities_are": { "const": "nouns_of_action" },
            "split_by": { "const": "electric_external_vs_magnetic_internal" },
            "electric_bit": { "const": 0 },
            "magnetic_bit": { "const": 1 },
            "authored_game_mechanics_not_physics": { "const": true }
          }
        }
      }
    },
    "admission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_effect", "graph_effect", "policy_effect", "ledger_effect", "admission_effect", "writes_court_pole_disposition", "kappa_court_access", "global_ch_access", "no_pentatonic_family_admission_claim", "crt310_gate_effect"],
      "properties": {
        "runtime_effect": { "const": false },
        "graph_effect": { "const": false },
        "policy_effect": { "const": false },
        "ledger_effect": { "const": false },
        "admission_effect": { "const": false },
        "writes_court_pole_disposition": { "const": false },
        "kappa_court_access": { "const": "read_only_replay" },
        "global_ch_access": { "const": "no_write" },
        "no_pentatonic_family_admission_claim": { "const": true },
        "crt310_gate_effect": { "const": false }
      }
    },
    "framework": { "$ref": "#/$defs/framework" },
    "elements": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/element" }
    },
    "guards": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guard_id", "status", "statement"],
        "properties": {
          "guard_id": { "type": "string", "minLength": 1 },
          "status": { "const": "enforced" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_id", "child_scaffold", "parent_categories", "instrumentation_registry"],
      "properties": {
        "framework_id": { "const": "teleological_phenomenon_master_framework" },
        "child_scaffold": {
          "type": "array",
          "const": ["energy_states", "transformations", "structural_forms", "transfer_modes"]
        },
        "parent_categories": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/framework_parent_category" }
        },
        "instrumentation_registry": { "$ref": "#/$defs/instrumentation_registry" }
      }
    },
    "framework_parent_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "section_id", "population_status"],
      "properties": {
        "category_id": { "enum": ["high_enthalpy_phenomena", "high_entropy_phenomena", "low_enthalpy_phenomena", "low_entropy_phenomena", "equilibrium_phenomena", "kinetics", "kinematics", "weather_dynamics"] },
        "section_id": { "type": ["string", "null"] },
        "population_status": { "enum": ["populated_in_this_registry", "placeholder_future_category"] }
      },
      "oneOf": [
        {
          "properties": {
            "category_id": { "const": "high_enthalpy_phenomena" },
            "section_id": { "const": "high_enthalpy_thermodynamics" },
            "population_status": { "const": "populated_in_this_registry" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "high_entropy_phenomena" },
            "section_id": { "const": "high_entropy_thermodynamics" },
            "population_status": { "const": "populated_in_this_registry" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "low_enthalpy_phenomena" },
            "section_id": { "const": "low_enthalpy_thermodynamics" },
            "population_status": { "const": "placeholder_future_category" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "low_entropy_phenomena" },
            "section_id": { "const": "low_entropy_thermodynamics" },
            "population_status": { "const": "placeholder_future_category" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "equilibrium_phenomena" },
            "section_id": { "const": "equilibrium_thermodynamics" },
            "population_status": { "const": "placeholder_future_category" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "kinetics" },
            "section_id": { "const": null },
            "population_status": { "const": "placeholder_future_category" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "kinematics" },
            "section_id": { "const": null },
            "population_status": { "const": "placeholder_future_category" }
          }
        },
        {
          "properties": {
            "category_id": { "const": "weather_dynamics" },
            "section_id": { "const": null },
            "population_status": { "const": "placeholder_future_category" }
          }
        }
      ]
    },
    "instrumentation_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_path", "status", "inclusion", "scope", "structural_descriptors_retained"],
      "properties": {
        "registry_id": { "const": "mechanics_instrumentation_registry" },
        "registry_path": { "const": "schemas/mechanics_instrumentation_registry.yaml" },
        "status": { "const": "future_separate_registry" },
        "inclusion": { "const": "excluded_from_this_registry" },
        "scope": { "const": "facilities_and_computational_simulation_models" },
        "structural_descriptors_retained": { "const": ["two_temperature_model", "multi_temperature_model"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanic_id", "definition", "relation_type", "value", "source_class"],
      "properties": {
        "mechanic_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "definition": { "type": "string", "minLength": 1 },
        "relation_type": { "type": "string", "enum": ["activated_by", "resists_by", "distributes", "constrains", "exchanges", "absorbs", "repels", "fixes", "transduces", "characterizes", "transforms", "structures", "transfers"] },
        "value": { "type": "string", "minLength": 1 },
        "source_class": { "const": "authored_capability" }
      }
    },
    "polar_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polarity_bit", "zodiac", "zodiac_facet_ref", "transition_ref", "mechanic_id", "definition", "relation_type", "value", "source_class"],
      "properties": {
        "polarity_bit": { "type": "integer", "enum": [0, 1] },
        "zodiac": { "enum": ["Aries", "Scorpio", "Sagittarius", "Pisces", "Libra", "Taurus", "Aquarius", "Capricorn"] },
        "zodiac_facet_ref": { "type": "string", "pattern": "^fivefold\\.zodiac\\.[a-z_.]+$" },
        "transition_ref": { "type": "string", "pattern": "^court_(advance|retreat)_C[0-4]_to_C[0-4]$" },
        "mechanic_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "definition": { "type": "string", "minLength": 1 },
        "relation_type": { "type": "string", "enum": ["activated_by", "resists_by", "distributes", "constrains", "exchanges", "absorbs", "repels", "fixes", "transduces", "characterizes", "transforms", "structures", "transfers"] },
        "value": { "type": "string", "minLength": 1 },
        "source_class": { "const": "authored_capability" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "governor", "school_ref", "scale_id", "scale_map_ref", "capabilities", "phenomenon_categories"],
      "properties": {
        "element": { "enum": ["Fire", "Air", "Water", "Earth", "Quintessence"] },
        "governor": { "enum": ["Mars", "Jupiter", "Venus", "Saturn", "Mercury"] },
        "school_ref": { "type": "string", "pattern": "^fivefold\\.capability_school\\.[a-z_]+$" },
        "scale_id": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "scale_map_ref": { "type": "string", "minLength": 1 },
        "transition_refs": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^court_(advance|retreat)_C[0-4]_to_C[0-4]$" } },
        "is_binary_court_pole": { "const": false },
        "court_pole_index": { "type": "null" },
        "register_membership": { "const": "excluded" },
        "engine_interface_ref": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["electric_external", "magnetic_internal"],
              "properties": {
                "electric_external": { "$ref": "#/$defs/polar_capability" },
                "magnetic_internal": { "$ref": "#/$defs/polar_capability" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine_interface"],
              "properties": {
                "engine_interface": { "$ref": "#/$defs/capability" }
              }
            }
          ]
        },
        "phenomenon_categories": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "high_enthalpy_phenomena": { "$ref": "#/$defs/high_enthalpy_phenomenon_category" },
            "high_entropy_phenomena": { "$ref": "#/$defs/high_entropy_phenomenon_category" },
            "low_enthalpy_phenomena": { "$ref": "#/$defs/low_enthalpy_phenomenon_category" },
            "low_entropy_phenomena": { "$ref": "#/$defs/low_entropy_phenomenon_category" },
            "equilibrium_phenomena": { "$ref": "#/$defs/equilibrium_phenomenon_category" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "element": { "const": "Fire" } } },
          "then": {
            "properties": {
              "phenomenon_categories": { "$ref": "#/$defs/fire_phenomenon_categories" }
            }
          }
        },
        {
          "if": { "properties": { "element": { "const": "Air" } } },
          "then": {
            "properties": {
              "phenomenon_categories": { "$ref": "#/$defs/air_phenomenon_categories" }
            }
          }
        },
        {
          "if": { "properties": { "element": { "const": "Water" } } },
          "then": {
            "properties": {
              "phenomenon_categories": { "$ref": "#/$defs/water_phenomenon_categories" }
            }
          }
        },
        {
          "if": { "properties": { "element": { "const": "Earth" } } },
          "then": {
            "properties": {
              "phenomenon_categories": { "$ref": "#/$defs/earth_phenomenon_categories" }
            }
          }
        },
        {
          "if": { "properties": { "element": { "const": "Quintessence" } } },
          "then": {
            "properties": {
              "phenomenon_categories": { "$ref": "#/$defs/quintessence_phenomenon_categories" }
            }
          }
        }
      ]
    },
    "high_enthalpy_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        { "properties": { "section_id": { "const": "high_enthalpy_thermodynamics" } } }
      ]
    },
    "high_entropy_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        { "properties": { "section_id": { "const": "high_entropy_thermodynamics" } } }
      ]
    },
    "low_enthalpy_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        { "properties": { "section_id": { "const": "low_enthalpy_thermodynamics" } } }
      ]
    },
    "low_entropy_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        { "properties": { "section_id": { "const": "low_entropy_thermodynamics" } } }
      ]
    },
    "equilibrium_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        { "properties": { "section_id": { "const": "equilibrium_thermodynamics" } } }
      ]
    },
    "phenomenon_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "population_status", "polarity_scope", "child_scaffold"],
      "properties": {
        "section_id": { "enum": ["high_enthalpy_thermodynamics", "high_entropy_thermodynamics", "low_enthalpy_thermodynamics", "low_entropy_thermodynamics", "equilibrium_thermodynamics"] },
        "population_status": { "enum": ["populated", "placeholder"] },
        "polarity_scope": { "enum": ["electric_external", "magnetic_internal", "engine_interface", "unassigned"] },
        "child_scaffold": { "$ref": "#/$defs/child_scaffold" }
      }
    },
    "populated_electric_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        {
          "properties": {
            "population_status": { "const": "populated" },
            "polarity_scope": { "const": "electric_external" },
            "child_scaffold": {
              "properties": {
                "energy_states": { "minItems": 1 },
                "transformations": { "minItems": 1 },
                "structural_forms": { "minItems": 1 },
                "transfer_modes": { "minItems": 1 }
              }
            }
          }
        }
      ]
    },
    "placeholder_phenomenon_category": {
      "allOf": [
        { "$ref": "#/$defs/phenomenon_category" },
        {
          "properties": {
            "population_status": { "const": "placeholder" },
            "polarity_scope": { "const": "unassigned" },
            "child_scaffold": {
              "properties": {
                "energy_states": { "maxItems": 0 },
                "transformations": { "maxItems": 0 },
                "structural_forms": { "maxItems": 0 },
                "transfer_modes": { "maxItems": 0 }
              }
            }
          }
        }
      ]
    },
    "fire_phenomenon_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_enthalpy_phenomena"],
      "properties": {
        "high_enthalpy_phenomena": {
          "allOf": [
            { "$ref": "#/$defs/high_enthalpy_phenomenon_category" },
            { "$ref": "#/$defs/populated_electric_phenomenon_category" }
          ]
        }
      }
    },
    "air_phenomenon_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_entropy_phenomena"],
      "properties": {
        "high_entropy_phenomena": {
          "allOf": [
            { "$ref": "#/$defs/high_entropy_phenomenon_category" },
            { "$ref": "#/$defs/populated_electric_phenomenon_category" }
          ]
        }
      }
    },
    "water_phenomenon_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_enthalpy_phenomena"],
      "properties": {
        "low_enthalpy_phenomena": {
          "allOf": [
            { "$ref": "#/$defs/low_enthalpy_phenomenon_category" },
            { "$ref": "#/$defs/placeholder_phenomenon_category" }
          ]
        }
      }
    },
    "earth_phenomenon_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_entropy_phenomena"],
      "properties": {
        "low_entropy_phenomena": {
          "allOf": [
            { "$ref": "#/$defs/low_entropy_phenomenon_category" },
            { "$ref": "#/$defs/placeholder_phenomenon_category" }
          ]
        }
      }
    },
    "quintessence_phenomenon_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equilibrium_phenomena"],
      "properties": {
        "equilibrium_phenomena": {
          "allOf": [
            { "$ref": "#/$defs/equilibrium_phenomenon_category" },
            { "$ref": "#/$defs/placeholder_phenomenon_category" }
          ]
        }
      }
    },
    "child_scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy_states", "transformations", "structural_forms", "transfer_modes"],
      "properties": {
        "energy_states": { "$ref": "#/$defs/glossary_entries" },
        "transformations": { "$ref": "#/$defs/glossary_entries" },
        "structural_forms": { "$ref": "#/$defs/glossary_entries" },
        "transfer_modes": { "$ref": "#/$defs/glossary_entries" }
      }
    },
    "glossary_entries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    }
  }
}
