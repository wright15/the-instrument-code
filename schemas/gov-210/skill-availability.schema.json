{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov-210.skill-availability.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillId", "name", "operationId", "registryNamespace", "registrySha256", "apiVersion", "bundleId", "bundleVersion", "inputSchemaId", "outputSchemaId"],
  "properties": {
    "skillId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "name": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "registryNamespace": {"enum": ["governor", "court"]},
    "registrySha256": {"$ref": "#/$defs/sha256"},
    "apiVersion": {"type": "string", "minLength": 1},
    "bundleId": {"type": "string", "minLength": 1},
    "bundleVersion": {"type": "string", "minLength": 1},
    "inputSchemaId": {"type": "string", "minLength": 1},
    "outputSchemaId": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
