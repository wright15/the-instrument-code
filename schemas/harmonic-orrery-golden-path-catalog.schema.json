{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/schemas/harmonic-orrery-golden-path-catalog.schema.json",
  "title": "Harmonic Orrery Golden-Path Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "paths"],
  "properties": {
    "schemaVersion": { "const": "golden-path.v1" },
    "status": { "const": "planning_evidence" },
    "catalog": { "$ref": "#/$defs/catalogNotes" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "catalogNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "segmentation", "promotion", "versioning"],
      "properties": {
        "thesis": { "type": "string", "minLength": 1 },
        "segmentation": { "type": "string", "minLength": 1 },
        "promotion": { "type": "string", "minLength": 1 },
        "versioning": { "type": "string", "minLength": 1 }
      }
    },
    "pitchClasses": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 11 },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "pitchClasses"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "modeTonicPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" }
      }
    },
    "cadenceHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "label",
        "nodeId",
        "chordLabel",
        "chordRoot",
        "collection",
        "pitchClasses",
        "seamCrossing",
        "legality"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["chord", "bridge"] },
        "label": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "chordLabel": { "type": "string" },
        "chordRoot": { "type": ["integer", "null"] },
        "collection": { "enum": ["aeolian", "harmonic-minor", "bridge"] },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" },
        "seamCrossing": { "type": "boolean" },
        "legality": { "enum": ["collection-membership", "both-collections-containment"] }
      }
    },
    "collectionHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "layer",
        "label",
        "nodeId",
        "mode",
        "moveId",
        "pitchClasses",
        "legality",
        "setClassId",
        "rotationAxis",
        "seamCrossing"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "const": "collection" },
        "layer": { "const": "walk" },
        "label": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "moveId": { "type": ["string", "null"] },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" },
        "legality": { "const": "set-class-preserved" },
        "setClassId": { "type": "string", "minLength": 1 },
        "rotationAxis": { "const": true },
        "seamCrossing": { "const": false }
      }
    },
    "derivedHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "nodeId",
        "nodeKind",
        "setClassId",
        "arrivedBy",
        "moveId",
        "legality",
        "bridge",
        "admittedBridge",
        "mShortcut",
        "label",
        "pitchClasses"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "const": "derived-node" },
        "nodeId": { "type": "string", "minLength": 1 },
        "nodeKind": { "enum": ["heptatonic", "pentatonic"] },
        "setClassId": { "type": "string", "minLength": 1 },
        "arrivedBy": { "enum": ["origin", "operator", "containment"] },
        "moveId": { "type": ["string", "null"] },
        "legality": {
          "type": ["string", "null"],
          "enum": [
            "catalog-membership",
            "both-collections-containment",
            "containment-membership",
            null
          ]
        },
        "bridge": { "type": "boolean" },
        "admittedBridge": { "type": "boolean" },
        "mShortcut": { "type": ["string", "null"] },
        "label": { "type": "string", "minLength": 1 },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" }
      }
    },
    "hop": {
      "oneOf": [
        { "$ref": "#/$defs/cadenceHop" },
        { "$ref": "#/$defs/collectionHop" },
        { "$ref": "#/$defs/derivedHop" }
      ]
    },
    "seam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "driftSemitones",
        "replacedPitchClass",
        "raisedPitchClass",
        "commonTones"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "driftSemitones": { "type": "integer", "minimum": 0, "maximum": 12 },
        "replacedPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 },
        "raisedPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 },
        "commonTones": { "type": "integer", "minimum": 0, "maximum": 7 }
      }
    },
    "modeAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setClassId",
        "structurePreserved",
        "focalPoint",
        "flattenedPitchClasses",
        "sharpenedPitchClasses",
        "commonTones",
        "basis"
      ],
      "properties": {
        "setClassId": { "type": "string", "minLength": 1 },
        "structurePreserved": { "const": true },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "tonicPitchClass"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "tonicPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 }
          }
        },
        "flattenedPitchClasses": { "$ref": "#/$defs/pitchClasses" },
        "sharpenedPitchClasses": { "$ref": "#/$defs/pitchClasses" },
        "commonTones": { "type": "integer", "minimum": 0, "maximum": 7 },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courtPositionId", "nodeId", "pitchClasses"],
      "properties": {
        "courtPositionId": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" }
      }
    },
    "voicing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "pitchClasses"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "setClassId": { "type": "string", "minLength": 1 },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chosen", "alternative", "basis", "legalityNote"],
      "properties": {
        "chosen": { "$ref": "#/$defs/voicing" },
        "alternative": { "$ref": "#/$defs/voicing" },
        "basis": { "type": "string", "minLength": 1 },
        "legalityNote": { "type": "string", "minLength": 1 }
      }
    },
    "walkChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "moves", "basis"],
      "properties": {
        "direction": { "type": "string", "minLength": 1 },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "demonstrationMove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorId",
        "applicationId",
        "canonicalId",
        "auditSource",
        "status",
        "legality",
        "compresses"
      ],
      "properties": {
        "operatorId": { "const": "M" },
        "applicationId": { "type": "string", "minLength": 1 },
        "canonicalId": { "type": "string", "minLength": 1 },
        "auditSource": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "legality": { "const": "demonstration" },
        "compresses": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "legalMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moveId", "legality"],
      "properties": {
        "moveId": { "type": "string", "minLength": 1 },
        "legality": { "enum": ["set-class-preserved", "catalog-membership"] }
      }
    },
    "mDemonstrationVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "moves"],
      "properties": {
        "variantId": { "type": "string", "minLength": 1 },
        "moves": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/demonstrationMove" },
              { "$ref": "#/$defs/legalMove" }
            ]
          }
        }
      }
    },
    "mDemonstration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "basis", "variants"],
      "properties": {
        "kind": { "const": "m-demonstration" },
        "basis": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mDemonstrationVariant" }
        }
      }
    },
    "reverseChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction", "moves", "basis"],
      "properties": {
        "kind": { "const": "reverse-chain" },
        "direction": { "type": "string", "minLength": 1 },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "alternative": {
      "oneOf": [
        { "$ref": "#/$defs/reverseChain" },
        { "$ref": "#/$defs/mDemonstration" }
      ]
    },
    "triadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "label", "pitchClasses", "minorThird"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "pitchClasses": { "$ref": "#/$defs/pitchClasses" },
        "minorThird": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": {
      "oneOf": [
        { "$ref": "#/$defs/recordedVerdict" },
        { "$ref": "#/$defs/pendingVerdict" }
      ]
    },
    "recordedVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdictId", "status", "subject", "statement", "source", "date"],
      "properties": {
        "verdictId": { "type": "string", "minLength": 1 },
        "status": { "const": "recorded" },
        "subject": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "pendingVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdictId", "status", "subject", "statement", "source", "recipe"],
      "properties": {
        "verdictId": { "type": "string", "minLength": 1 },
        "status": { "const": "pending" },
        "subject": { "type": "string", "minLength": 1 },
        "statement": { "type": "null" },
        "source": { "type": "string", "minLength": 1 },
        "recipe": { "type": "string", "minLength": 1 }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathId", "substrate", "origin", "destination", "hops"],
      "properties": {
        "pathId": { "type": "string", "minLength": 1 },
        "substrate": {
          "enum": [
            "golden-path",
            "golden-path-parallel-minor",
            "derived-path"
          ]
        },
        "tonicPitchClass": { "type": "integer", "minimum": 0, "maximum": 11 },
        "origin": { "$ref": "#/$defs/endpoint" },
        "destination": { "$ref": "#/$defs/endpoint" },
        "seam": { "$ref": "#/$defs/seam" },
        "modeAxis": { "$ref": "#/$defs/modeAxis" },
        "interiorKernels": {
          "type": "array",
          "items": { "$ref": "#/$defs/kernel" }
        },
        "bridge": { "$ref": "#/$defs/bridge" },
        "chosen": { "$ref": "#/$defs/walkChoice" },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" }
        },
        "triadOverlay": {
          "type": "array",
          "items": { "$ref": "#/$defs/triadEntry" }
        },
        "schemaNote": { "type": "string", "minLength": 1 },
        "hopCount": { "type": "integer", "minimum": 0 },
        "crossesBridge": { "type": "boolean" },
        "mShortcuts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["applicationId", "canonicalId", "hopIndices"],
            "properties": {
              "applicationId": { "type": "string", "minLength": 1 },
              "canonicalId": { "type": "string", "minLength": 1 },
              "hopIndices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "verdicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/verdict" }
        },
        "hops": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hop" }
        }
      }
    }
  }
}
