{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanics-thermodynamics-registry-validation.v2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "registryVersion", "verdict", "checksPassed", "checksFailed", "checks", "reportFingerprint"],
  "properties": {
    "schemaVersion": { "const": "mechanics-thermodynamics-registry-validation.v2.0.0" },
    "registryId": { "const": "mechanics_thermodynamics_registry" },
    "registryVersion": { "const": "2.0.0" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "checksPassed": { "type": "integer", "minimum": 0 },
    "checksFailed": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "diagnostic", "evidenceLocator", "expected", "actual", "status"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "diagnostic": {},
          "evidenceLocator": { "type": "string", "minLength": 1 },
          "expected": {},
          "actual": {},
          "status": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "reportFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
