{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/schemas/semantic-operator-v1.0.1.schema.json",
  "title": "Seven Governors Semantic Operator Registry v1.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "dependencies",
    "structural_enforcement",
    "compression_coordinate_contract",
    "route_context",
    "immutability_guard",
    "physical_process_contract",
    "operator_binding_map",
    "operators"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "version",
        "status",
        "author",
        "layer",
        "description",
        "architecture"
      ],
      "properties": {
        "registry_id": { "const": "semantic_operator_registry" },
        "version": { "const": "1.0.1" },
        "status": { "const": "admitted" },
        "author": { "type": "string", "minLength": 1 },
        "layer": { "const": 4 },
        "description": { "type": "string", "minLength": 1 },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operators_are",
            "intrinsic_identity",
            "contextual_identity",
            "canonical_rendering_definition"
          ],
          "properties": {
            "operators_are": { "type": "string", "minLength": 1 },
            "intrinsic_identity": { "type": "string", "minLength": 1 },
            "contextual_identity": { "type": "string", "minLength": 1 },
            "canonical_rendering_definition": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algebraic_release"],
      "properties": {
        "algebraic_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version", "release_id", "relationship"],
          "properties": {
            "package": { "const": "seven-governors-mutation-algebra-audit" },
            "version": { "const": "1.0.0" },
            "release_id": { "const": "mutation-algebra-audit:1.0.0" },
            "relationship": { "const": "foreign_key_authority" }
          }
        }
      }
    },
    "structural_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "enforced_by", "validates", "registry_contract"],
      "properties": {
        "authority": { "const": "upstream" },
        "enforced_by": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "validates": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "registry_contract": { "type": "string", "minLength": 1 }
      }
    },
    "compression_coordinate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C_P", "C_H", "C_S"],
      "properties": {
        "C_P": { "$ref": "#/$defs/compressionCoordinate" },
        "C_H": { "$ref": "#/$defs/compressionCoordinate" },
        "C_S": { "$ref": "#/$defs/compressionCoordinate" }
      }
    },
    "route_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "scope",
        "accumulation",
        "overlay_cardinality",
        "replacement_rule",
        "identity_effect",
        "render_effect",
        "confluence_rule"
      ],
      "properties": {
        "context_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "accumulation": { "type": "string", "minLength": 1 },
        "overlay_cardinality": { "type": "integer", "minimum": 1 },
        "replacement_rule": { "type": "string", "minLength": 1 },
        "identity_effect": { "type": "string", "minLength": 1 },
        "render_effect": { "type": "string", "minLength": 1 },
        "confluence_rule": { "type": "string", "minLength": 1 }
      }
    },
    "immutability_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlays_may_not_overwrite", "violation_policy"],
      "properties": {
        "overlays_may_not_overwrite": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["Governor_office", "anchor_tier", "C_H", "bitmask"]
          }
        },
        "violation_policy": { "type": "string", "minLength": 1 }
      }
    },
    "physical_process_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "equation_field", "rule"],
      "properties": {
        "execution_mode": { "const": "symbolic_only" },
        "equation_field": { "const": "symbolic_anchor" },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "operator_binding_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R1", "L1", "R2", "L2", "R3", "L3", "R4", "L4", "R5", "L5", "R6", "L6", "R7", "L7", "M"],
      "properties": {
        "R1": { "const": "saturn_degree_raise_v1" },
        "L1": { "const": "saturn_degree_lower_v1" },
        "R2": { "const": "jupiter_degree_raise_v1" },
        "L2": { "const": "jupiter_degree_lower_v1" },
        "R3": { "const": "mars_degree_raise_v1" },
        "L3": { "const": "mars_degree_lower_v1" },
        "R4": { "const": "sun_degree_raise_v1" },
        "L4": { "const": "sun_degree_lower_v1" },
        "R5": { "const": "venus_degree_raise_v1" },
        "L5": { "const": "venus_degree_lower_v1" },
        "R6": { "const": "mercury_degree_raise_v1" },
        "L6": { "const": "mercury_degree_lower_v1" },
        "R7": { "const": "moon_degree_raise_v1" },
        "L7": { "const": "moon_degree_lower_v1" },
        "M": { "const": "modal_shift_v1" }
      }
    },
    "operators": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operator" }
    }
  },
  "$defs": {
    "compressionCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "overlay_access", "rule"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "overlay_access": { "enum": ["read_only", "shade_only"] },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "algebraicOperatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "operator_id", "domain_ref", "inverse_ref"],
      "properties": {
        "release_id": { "const": "mutation-algebra-audit:1.0.0" },
        "operator_id": { "enum": ["M", "R1", "L1", "R2", "L2", "R3", "L3", "R4", "L4", "R5", "L5", "R6", "L6", "R7", "L7"] },
        "domain_ref": {
          "type": "string",
          "pattern": "^seven-governors-mutation-algebra-audit/audit/operator-applications\\.csv#operator_id=(M|[RL][1-7])$"
        },
        "inverse_ref": {
          "type": "string",
          "pattern": "^seven-governors-mutation-algebra-audit/audit/inverse-witnesses\\.csv#operator_id=(M|[RL][1-7])&inverse_operator_id=(M\\^6|[RL][1-7])$"
        },
        "law_refs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "physicalProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "physical_domain", "symbolic_anchor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "physical_domain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "symbolic_anchor": { "type": "string", "minLength": 1 }
      }
    },
    "domainProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotes", "suppresses", "domain_projection_delta"],
      "properties": {
        "promotes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "suppresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "domain_projection_delta": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/domainProjection" }
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_id",
        "algebraic_operator_ref",
        "degree_governor",
        "degree_number",
        "direction",
        "physical_process",
        "semantic_delta",
        "preserves"
      ],
      "properties": {
        "operator_id": {
          "enum": [
            "saturn_degree_raise_v1",
            "saturn_degree_lower_v1",
            "jupiter_degree_raise_v1",
            "jupiter_degree_lower_v1",
            "mars_degree_raise_v1",
            "mars_degree_lower_v1",
            "sun_degree_raise_v1",
            "sun_degree_lower_v1",
            "venus_degree_raise_v1",
            "venus_degree_lower_v1",
            "mercury_degree_raise_v1",
            "mercury_degree_lower_v1",
            "moon_degree_raise_v1",
            "moon_degree_lower_v1",
            "modal_shift_v1"
          ]
        },
        "algebraic_operator_ref": { "$ref": "#/$defs/algebraicOperatorRef" },
        "degree_governor": {
          "type": ["string", "null"],
          "enum": ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn", null]
        },
        "degree_number": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 7
        },
        "direction": { "enum": ["raise", "lower", "rotate"] },
        "structural_effect_summary": { "type": "string", "minLength": 1 },
        "physical_process": { "$ref": "#/$defs/physicalProcess" },
        "semantic_delta": { "$ref": "#/$defs/semanticDelta" },
        "preserves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operator_id": { "const": "modal_shift_v1" } }, "required": ["operator_id"] },
          "then": {
            "required": ["structural_effect_summary", "transports"],
            "properties": {
              "degree_governor": { "type": "null" },
              "degree_number": { "type": "null" },
              "direction": { "const": "rotate" },
              "structural_effect_summary": { "type": "string", "minLength": 1 },
              "transports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "algebraic_operator_ref": {
                "allOf": [
                  { "$ref": "#/$defs/algebraicOperatorRef" },
                  {
                    "type": "object",
                    "required": ["law_refs"],
                    "properties": {
                      "operator_id": { "const": "M" },
                      "law_refs": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "degree_governor": { "type": "string" },
              "degree_number": { "type": "integer", "minimum": 1, "maximum": 7 },
              "direction": { "enum": ["raise", "lower"] }
            }
          }
        }
      ]
    }
  }
}
