{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elemental-pentatonic-scale-map.v1.0.0",
  "title": "Elemental Pentatonic Scale Map (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "admission_boundary", "orientation_policy", "scale_bindings", "invariants", "guards"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "version", "admission_status", "physical_quantity_claim", "no_electromagnetic_equivalence", "description", "architecture"],
      "properties": {
        "registry_id": { "const": "elemental_pentatonic_scale_map" },
        "version": { "const": "1.0.0" },
        "admission_status": { "const": "proposed" },
        "physical_quantity_claim": { "const": false },
        "no_electromagnetic_equivalence": { "const": true },
        "description": { "type": "string", "minLength": 1 },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dual_core", "emblem_not_register"],
          "properties": {
            "dual_core": { "type": "object", "additionalProperties": false, "required": ["ontological_layer", "teleological_layer"], "properties": {
              "ontological_layer": { "type": "object", "additionalProperties": false, "required": ["nodes", "physics_category", "coordinate", "content", "examples", "variation_axis"], "properties": {
                "nodes": { "const": "7-35" }, "physics_category": { "const": "Photonic" }, "coordinate": { "const": "C_P" },
                "content": { "type": "string", "minLength": 1 }, "examples": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                "variation_axis": { "const": "7 Governors" } } },
              "teleological_layer": { "type": "object", "additionalProperties": false, "required": ["nodes", "physics_category", "coordinate", "content", "examples", "variation_axis"], "properties": {
                "nodes": { "const": "5-35" }, "physics_category": { "const": "Electromagnetic" }, "coordinate": { "const": "kappa_court" },
                "content": { "type": "string", "minLength": 1 }, "examples": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                "variation_axis": { "const": "4 element axes plus Mercury engine" } } }
            } },
            "emblem_not_register": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "admission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_effect", "graph_effect", "policy_effect", "ledger_effect", "admission_effect", "writes_court_pole_disposition", "kappa_court_access", "global_ch_access", "no_pentatonic_family_admission_claim", "crt310_gate_effect"],
      "properties": {
        "runtime_effect": { "const": false },
        "graph_effect": { "const": false },
        "policy_effect": { "const": false },
        "ledger_effect": { "const": false },
        "admission_effect": { "const": false },
        "writes_court_pole_disposition": { "const": false },
        "kappa_court_access": { "const": "read_only_replay" },
        "global_ch_access": { "const": "no_write" },
        "no_pentatonic_family_admission_claim": { "const": true },
        "crt310_gate_effect": { "const": false }
      }
    },
    "orientation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mask_string_written_msb", "pitch_mask_integer_lsb", "ordinary_msb_parse_forbidden", "statement"],
      "properties": {
        "mask_string_written_msb": { "const": true },
        "pitch_mask_integer_lsb": { "const": true },
        "ordinary_msb_parse_forbidden": { "const": true },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "scale_bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    },
    "invariants": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "statement"],
        "properties": {
          "invariant_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guards": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["guard_id", "status", "statement"],
        "properties": {
          "guard_id": { "type": "string", "minLength": 1 },
          "status": { "const": "enforced" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element", "school_ref", "zodiac_facets", "ian_ring_id", "ian_ring_name",
        "ian_ring_url", "mask_string_msb", "pitch_mask", "as_written_msb_integer",
        "pitch_classes", "prime_form", "forte_class", "interval_structure",
        "interval_vector", "court_position", "kappa_court", "brightness",
        "emblem_role", "semantic_fit", "complement_evidence", "transition_refs"
      ],
      "properties": {
        "element": { "enum": ["Fire (Mars)", "Air / Wind (Jupiter)", "Quintessence (Mercury)", "Water (Venus)", "Earth (Saturn)"] },
        "school_ref": { "type": "string", "pattern": "^fivefold\\.capability_school\\.[a-z_]+$" },
        "zodiac_facets": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^fivefold\\.zodiac\\.[a-z_.]+$" } },
        "ian_ring_id": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "ian_ring_name": { "type": "string", "minLength": 1 },
        "ian_ring_url": { "type": "string", "pattern": "^https://ianring\\.com/musictheory/scales/[0-9]+$" },
        "mask_string_msb": { "type": "string", "pattern": "^[01]{12}$" },
        "pitch_mask": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "as_written_msb_integer": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "pitch_classes": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 11 } },
        "prime_form": { "const": [0, 2, 4, 7, 9] },
        "forte_class": { "const": "5-35" },
        "interval_structure": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "integer", "minimum": 1, "maximum": 4 } },
        "interval_vector": { "const": [0, 3, 2, 1, 4, 0] },
        "court_position": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
        "kappa_court": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 1 } } },
        "brightness": { "type": "integer", "minimum": 0 },
        "emblem_role": { "type": "string", "minLength": 1 },
        "semantic_fit": { "type": "string", "minLength": 1 },
        "is_binary_court_pole": { "const": false },
        "court_pole_index": { "type": "null" },
        "register_membership": { "const": "excluded" },
        "engine_interface_ref": { "type": "string", "minLength": 1 },
        "complement_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_heptatonic_complement_mask", "complement_governor", "relation_admission"],
          "properties": {
            "raw_heptatonic_complement_mask": { "type": "integer", "minimum": 0, "maximum": 4095 },
            "complement_governor": { "enum": ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"] },
            "relation_admission": { "const": "frozen_evidence_not_active_graph_relation" }
          }
        },
        "transition_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
