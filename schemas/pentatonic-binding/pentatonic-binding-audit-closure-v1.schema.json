{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-epic-400.pentatonic-binding-audit-closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "admissionEffect", "graphScope", "crt310Execution", "verdict", "evidenceBindings", "counts", "checksPassed", "checksFailed", "checks", "reportFingerprint"],
  "properties": {
    "schemaVersion": {"const": "pre-epic-400.pentatonic-binding-audit-closure.v1"},
    "reportId": {"const": "pentatonic-binding-audit-closure-v1"},
    "status": {"const": "planning_evidence"},
    "admissionEffect": {"const": "none"},
    "graphScope": {"const": "detached_audit_only"},
    "crt310Execution": {"const": false},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "evidenceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateFingerprint", "phase1ValidationReportFingerprint", "phase2Neo4jReportFingerprint", "phase3ReportSha256", "cypherDeterministicFingerprint", "crt310BacklogFingerprint", "sourceAuthoritySha256", "decisionLedgerSha256"],
      "properties": {
        "candidateFingerprint": {"$ref": "#/$defs/sha256"},
        "phase1ValidationReportFingerprint": {"$ref": "#/$defs/sha256"},
        "phase2Neo4jReportFingerprint": {"$ref": "#/$defs/sha256"},
        "phase3ReportSha256": {"$ref": "#/$defs/sha256"},
        "cypherDeterministicFingerprint": {"$ref": "#/$defs/sha256"},
        "crt310BacklogFingerprint": {"$ref": "#/$defs/sha256"},
        "sourceAuthoritySha256": {"$ref": "#/$defs/sha256"},
        "decisionLedgerSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitchSetCount", "incidenceCount", "classCount", "reviewedRootedWitnessCount", "detachedRealizationCount", "subsetEdgeCount", "zodiacRecordCount", "proposedClassCount"],
      "properties": {
        "pitchSetCount": {"const": 792},
        "incidenceCount": {"const": 252},
        "classCount": {"const": 38},
        "reviewedRootedWitnessCount": {"const": 7},
        "detachedRealizationCount": {"const": 7},
        "subsetEdgeCount": {"const": 19},
        "zodiacRecordCount": {"const": 12},
        "proposedClassCount": {"const": 35}
      }
    },
    "checksPassed": {"type": "integer", "minimum": 0},
    "checksFailed": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "diagnostic", "status"],
        "properties": {
          "checkId": {"type": "string", "minLength": 1},
          "diagnostic": {},
          "status": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "reportFingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
