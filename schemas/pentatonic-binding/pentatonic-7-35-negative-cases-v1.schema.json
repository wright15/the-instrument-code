        "required": ["caseId", "mutation", "expectedCode"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "mutation": {"type": "string", "minLength": 1},
          "expectedCode": {
            "enum": [
              "universal_three_parent_claim_rejected",
              "five_32_parent_count_invalid",
              "mars_internal_relation_invalid",
              "coordinate_collision_identity_forbidden",
              "c2_parent_window_invalid",
              "class_subset_endpoint_guard_invalid",
              "complement_used_as_parent",
              "source_binding_mismatch",
              "parent_incidence_invalid"
