{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crt-348.fivefold-engine-promotion-evidence.v1",
  "title": "Fivefold engine promotion evidence (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "admissionStatus",
    "contractPath",
    "contractSha256",
    "contractSchemaValid",
    "verdict",
    "sourceBindings",
    "itemEvidence",
    "exclusionEvidence",
    "evidenceFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "crt-348.fivefold-engine-promotion-evidence.v1" },
    "evidenceId": { "const": "fivefold-engine-promotion-evidence-v1" },
    "admissionStatus": { "const": "admitted" },
    "contractPath": { "const": "schemas/fivefold-engine-admission-contract.json" },
    "contractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contractSchemaValid": { "const": true },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "sourceBindings": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "itemEvidence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "status", "checks"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkId", "locator", "expected", "actual", "pass"],
              "properties": {
                "checkId": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "minLength": 1 },
                "expected": {},
                "actual": {},
                "pass": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "exclusionEvidence": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exclusionId", "status", "checks"],
        "properties": {
          "exclusionId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkId", "locator", "expected", "actual", "pass"],
              "properties": {
                "checkId": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "minLength": 1 },
                "expected": {},
                "actual": {},
                "pass": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "evidenceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
