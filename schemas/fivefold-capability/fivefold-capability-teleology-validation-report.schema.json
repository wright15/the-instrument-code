{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crt-347.fivefold-capability-teleology-validation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verdict", "candidateId", "candidateFingerprint", "checksPassed", "checksFailed", "checks", "reportFingerprint"],
  "properties": {
    "schemaVersion": { "const": "crt-347.fivefold-capability-teleology-validation.v1" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "candidateId": { "const": "fivefold-capability-teleology-v1" },
    "candidateFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checksPassed": { "type": "integer", "minimum": 0 },
    "checksFailed": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "diagnostic", "evidenceLocator", "expected", "actual", "status"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "diagnostic": {},
          "evidenceLocator": { "type": "string", "minLength": 1 },
          "expected": {},
          "actual": {},
          "status": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "reportFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
