{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gov-208.vault-note-frontmatter.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["noteId", "admissionStatus", "source", "sensitivity"],
  "properties": {
    "noteId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "aspectRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ruleRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "governor": {"enum": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn"]},
    "admissionStatus": {"enum": ["admitted", "admitted-bridge", "proposed", "unresolved"]},
    "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "sensitivity": {"enum": ["public", "private", "restricted"]},
    "maxTraversalDepth": {"type": "integer", "minimum": 0, "maximum": 4}
  }
}
