{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-validation-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verdict", "checksPassed", "checksFailed", "checks", "reportFingerprint"],
  "properties": {
    "schemaVersion": {"enum": ["gov-208.validation-report.v1", "crt-308.validation-report.v1"]},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "checksPassed": {"type": "integer", "minimum": 0},
    "checksFailed": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "diagnostic"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL"]},
          "diagnostic": {}
        }
      }
    },
    "reportFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
