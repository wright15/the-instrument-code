{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crt-310.pentatonic-set-class-admission-backlog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "backlogId", "storyId", "baselineIntegratedReleaseId", "baselineAdmissionId", "status", "authority", "admissionEffect", "historicalCandidateBytesPreserved", "reviewUnit", "bulkPromotionAllowed", "maxClassesPerAdmissionDecision", "sourceBindings", "requiredGateIds", "gateDefinitions", "items", "summary", "backlogFingerprint"],
  "properties": {
    "schemaVersion": {"const": "crt-310.pentatonic-set-class-admission-backlog.v1"},
    "backlogId": {"const": "court-admission-backlog:crt-310:1"},
    "storyId": {"const": "CRT-310"},
    "baselineIntegratedReleaseId": {"const": "seven-governors-integrated-1.3.0"},
    "baselineAdmissionId": {"const": "court-admission:crt-309:1.0.0"},
    "status": {"const": "backlog"},
    "authority": {"const": "admission_planning_only"},
    "admissionEffect": {"const": "none"},
    "historicalCandidateBytesPreserved": {"const": true},
    "reviewUnit": {"const": "one_pentatonic_set_class"},
    "bulkPromotionAllowed": {"const": false},
    "maxClassesPerAdmissionDecision": {"const": 1},
    "sourceBindings": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceBinding"}},
    "requiredGateIds": {"const": ["source_identity", "complement_closure", "harmonic_characterization", "transition_semantics", "application_necessity", "authority_safety", "deterministic_candidate_release"]},
    "gateDefinitions": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/gateDefinition"}},
    "items": {"type": "array", "minItems": 35, "maxItems": 35, "items": {"$ref": "#/$defs/item"}},
    "summary": {"$ref": "#/$defs/summary"},
    "backlogFingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sourceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "path", "sha256", "intrinsicFingerprint", "role", "frozen"],
      "properties": {
        "bindingId": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}, "intrinsicFingerprint": {"$ref": "#/$defs/nullableSha256"},
        "role": {"type": "string", "minLength": 1}, "frozen": {"const": true}
      }
    },
    "gateDefinition": {
      "type": "object", "additionalProperties": false, "required": ["gateId", "criterion"],
      "properties": {"gateId": {"type": "string", "minLength": 1}, "criterion": {"type": "string", "minLength": 1}}
    },
    "recordSelector": {
      "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
      "properties": {"setClassId": {"type": "string"}, "complementMapId": {"type": "string"}}
    },
    "recordBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "artifactSha256", "recordSelector"],
      "properties": {"path": {"type": "string"}, "artifactSha256": {"$ref": "#/$defs/sha256"}, "recordSelector": {"$ref": "#/$defs/recordSelector"}}
    },
    "complementBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "artifactSha256", "recordSelector", "complementMapId", "heptatonicFamilyId"],
      "properties": {"path": {"type": "string"}, "artifactSha256": {"$ref": "#/$defs/sha256"}, "recordSelector": {"$ref": "#/$defs/recordSelector"}, "complementMapId": {"type": "string"}, "heptatonicFamilyId": {"type": "string", "pattern": "^7-"}}
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false, "required": ["evidenceId", "path", "sha256", "recordSelector", "claim"],
      "properties": {"evidenceId": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "recordSelector": {"$ref": "#/$defs/recordSelector"}, "claim": {"type": "string"}}
    },
    "gateResult": {
      "type": "object", "additionalProperties": false, "required": ["gateId", "status", "evidenceRefs", "fixtureIds", "criterionIds", "diagnosticCodes"],
      "properties": {
        "gateId": {"type": "string"}, "status": {"enum": ["satisfied", "pending", "failed"]},
        "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "fixtureIds": {"type": "array", "items": {"type": "string"}},
        "criterionIds": {"type": "array", "items": {"type": "string"}},
        "diagnosticCodes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["itemId", "setClassId", "forteNumber", "forteOrdinal", "candidateIdentity", "sourceRecordBinding", "complementRecordBinding", "currentAdmissionStatus", "effectiveAdmissionStatus", "requestedAdmissionRole", "workflowStatus", "eligibleForAdmissionReview", "admissionDecision", "promotionReleaseId", "decisionLedgerRef", "gateResults", "itemFingerprint"],
      "properties": {
        "itemId": {"type": "string"}, "setClassId": {"type": "string", "pattern": "^pentatonic:5-"}, "forteNumber": {"type": "string", "pattern": "^5-"}, "forteOrdinal": {"type": "integer", "minimum": 1, "maximum": 38},
        "candidateIdentity": {"type": "object", "additionalProperties": false, "required": ["representativePitchClasses", "representativeMask", "representativeMask12", "weight", "sourceScaleStateId"], "properties": {"representativePitchClasses": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 11}}, "representativeMask": {"type": "integer", "minimum": 1, "maximum": 4095}, "representativeMask12": {"type": "string", "pattern": "^[01]{12}$"}, "weight": {"const": 5}, "sourceScaleStateId": {"type": "integer", "minimum": 1, "maximum": 4095}}},
        "sourceRecordBinding": {"$ref": "#/$defs/recordBinding"}, "complementRecordBinding": {"$ref": "#/$defs/complementBinding"},
        "currentAdmissionStatus": {"const": "proposed"}, "effectiveAdmissionStatus": {"const": "proposed"},
        "requestedAdmissionRole": {"type": "null"}, "workflowStatus": {"const": "evidence_pending"},
        "eligibleForAdmissionReview": {"const": false}, "admissionDecision": {"const": "not_made"},
        "promotionReleaseId": {"type": "null"}, "decisionLedgerRef": {"type": "null"},
        "gateResults": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/gateResult"}},
        "itemFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["itemCount", "proposedCount", "eligibleForAdmissionReviewCount", "admittedCount", "gateDefinitionCount", "satisfiedGateResultCount", "pendingGateResultCount", "failedGateResultCount"],
      "properties": {"itemCount": {"const": 35}, "proposedCount": {"const": 35}, "eligibleForAdmissionReviewCount": {"const": 0}, "admittedCount": {"const": 0}, "gateDefinitionCount": {"const": 7}, "satisfiedGateResultCount": {"const": 70}, "pendingGateResultCount": {"const": 175}, "failedGateResultCount": {"const": 0}}
    }
  }
}
