{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/schemas/harmonic-orrery-legal-moves.schema.json",
  "title": "Harmonic Orrery Legal Move Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogFingerprint",
    "scope",
    "sources",
    "operators",
    "moves"
  ],
  "properties": {
    "schemaVersion": { "const": "harmonic-orrery.legal-moves.v2" },
    "catalogId": {
      "enum": [
        "harmonic-orrery.modal-anchor-cycles.v1",
        "harmonic-orrery.parallel-anchor-edges.v1"
      ]
    },
    "catalogFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "$ref": "#/$defs/scope" },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/source" }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/operator" }
    },
    "moves": {
      "type": "array",
      "minItems": 21,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/move" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodesSchemaVersion",
        "harmonicDescriptorReleaseId",
        "harmonicDescriptorFingerprint",
        "anchorIds",
        "anchors"
      ],
      "properties": {
        "nodesSchemaVersion": { "const": "harmonic-orrery.nodes.v2" },
        "harmonicDescriptorReleaseId": {
          "const": "harmonic-compression-candidate:CH_A012_q_v1:1.0.0"
        },
        "harmonicDescriptorFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "anchorIds": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4095 }
        },
        "anchors": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "tier", "forteFamily", "office"],
      "properties": {
        "stateId": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "tier": { "enum": ["A0", "A1", "A2"] },
        "forteFamily": { "enum": ["7-35", "7-34", "7-33"] },
        "office": { "enum": ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "role"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatorId",
        "notation",
        "name",
        "operatorClass",
        "degree",
        "degreeGovernor",
        "direction",
        "inverseOperatorId",
        "partial",
        "status"
      ],
      "properties": {
        "operatorId": {
          "anyOf": [
            { "const": "M" },
            { "type": "string", "pattern": "^[RL][2-7]$" }
          ]
        },
        "notation": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "operatorClass": {
          "anyOf": [
            { "const": "modal_re_rooting" },
            { "const": "fixed_degree_shift" }
          ]
        },
        "degree": {
          "anyOf": [{ "const": null }, { "type": "integer", "minimum": 1, "maximum": 7 }]
        },
        "degreeGovernor": {
          "anyOf": [
            { "const": null },
            { "enum": ["Saturn", "Jupiter", "Mars", "Sun", "Venus", "Mercury", "Moon"] }
          ]
        },
        "direction": {
          "anyOf": [{ "const": "successor" }, { "enum": ["raise", "lower"] }]
        },
        "inverseOperatorId": { "type": "string", "minLength": 1 },
        "partial": { "type": "boolean" },
        "status": { "const": "structurally_validated" }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "targetId", "operatorId", "availability", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^([M]|R[2-7]|L[2-7]):[0-9]+:[0-9]+$" },
        "sourceId": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "targetId": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "operatorId": {
          "anyOf": [{ "const": "M" }, { "type": "string", "pattern": "^[RL][2-7]$" }]
        },
        "availability": { "const": "available" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "applicationId",
        "projectionStatus",
        "structuralEvidence",
        "structuralEdgeTypes",
        "structuralEdgeIds"
      ],
      "properties": {
        "applicationId": { "type": "string", "pattern": "^([M]|R[2-7]|L[2-7]):[0-9]+:[0-9]+$" },
        "projectionStatus": {
          "anyOf": [
            { "const": "canonical_modal_edge_projected" },
            { "const": "audited_parallel_edge_projected" }
          ]
        },
        "structuralEvidence": { "type": "boolean" },
        "structuralEdgeTypes": { "type": ["string", "null"] },
        "structuralEdgeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
