{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanics-thermodynamics-registry.v2.0.0",
  "title": "Mechanics Thermodynamics Registry v2 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "admission_boundary", "framework", "elements", "guards"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "admission_boundary": { "$ref": "#/$defs/admission_boundary" },
    "framework": { "$ref": "#/$defs/framework" },
    "elements": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/fire_element" },
        { "$ref": "#/$defs/air_element" },
        { "$ref": "#/$defs/water_element" },
        { "$ref": "#/$defs/earth_element" },
        { "$ref": "#/$defs/quintessence_element" }
      ],
      "items": false
    },
    "guards": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/guard" }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "version", "status", "admission_status", "author", "layer", "physical_quantity_claim", "no_electromagnetic_equivalence", "no_thermodynamic_equivalence_with_kappa_court", "description", "architecture"],
      "properties": {
        "registry_id": { "const": "mechanics_thermodynamics_registry" },
        "version": { "const": "2.0.0" },
        "status": { "const": "proposed_canonization" },
        "admission_status": { "const": "proposed" },
        "author": { "type": "string", "minLength": 1 },
        "layer": { "const": 4 },
        "physical_quantity_claim": { "const": false },
        "no_electromagnetic_equivalence": { "const": true },
        "no_thermodynamic_equivalence_with_kappa_court": { "const": true },
        "description": { "type": "string", "minLength": 1 },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities_are", "split_by", "electric_bit", "magnetic_bit", "authored_game_mechanics_not_physics"],
          "properties": {
            "capabilities_are": { "const": "nouns_of_action" },
            "split_by": { "const": "electric_external_vs_magnetic_internal" },
            "electric_bit": { "const": 0 },
            "magnetic_bit": { "const": 1 },
            "authored_game_mechanics_not_physics": { "const": true }
          }
        }
      }
    },
    "admission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_effect", "graph_effect", "policy_effect", "ledger_effect", "admission_effect", "writes_court_pole_disposition", "kappa_court_access", "global_ch_access", "no_pentatonic_family_admission_claim", "crt310_gate_effect"],
      "properties": {
        "runtime_effect": { "const": false },
        "graph_effect": { "const": false },
        "policy_effect": { "const": false },
        "ledger_effect": { "const": false },
        "admission_effect": { "const": false },
        "writes_court_pole_disposition": { "const": false },
        "kappa_court_access": { "const": "read_only_replay" },
        "global_ch_access": { "const": "no_write" },
        "no_pentatonic_family_admission_claim": { "const": true },
        "crt310_gate_effect": { "const": false }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_id", "child_scaffold", "parent_categories", "instrumentation_registry"],
      "properties": {
        "framework_id": { "const": "teleological_phenomenon_master_framework" },
        "child_scaffold": { "const": ["energy_states", "transformations", "structural_forms", "transfer_modes"] },
        "parent_categories": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/framework_parent_category" }
        },
        "instrumentation_registry": { "$ref": "#/$defs/instrumentation_registry" }
      }
    },
    "framework_parent_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "section_id", "population_status"],
      "properties": {
        "category_id": { "enum": ["high_enthalpy_phenomena", "high_entropy_phenomena", "low_enthalpy_phenomena", "low_entropy_phenomena", "equilibrium_phenomena", "kinetics", "kinematics", "weather_dynamics"] },
        "section_id": { "type": ["string", "null"] },
        "population_status": { "enum": ["populated_in_this_registry", "placeholder_future_category"] }
      },
      "oneOf": [
        { "properties": { "category_id": { "const": "high_enthalpy_phenomena" }, "section_id": { "const": "high_enthalpy_thermodynamics" }, "population_status": { "const": "populated_in_this_registry" } } },
        { "properties": { "category_id": { "const": "high_entropy_phenomena" }, "section_id": { "const": "high_entropy_thermodynamics" }, "population_status": { "const": "populated_in_this_registry" } } },
        { "properties": { "category_id": { "const": "low_enthalpy_phenomena" }, "section_id": { "const": "low_enthalpy_thermodynamics" }, "population_status": { "const": "populated_in_this_registry" } } },
        { "properties": { "category_id": { "const": "low_entropy_phenomena" }, "section_id": { "const": "low_entropy_thermodynamics" }, "population_status": { "const": "populated_in_this_registry" } } },
        { "properties": { "category_id": { "const": "equilibrium_phenomena" }, "section_id": { "const": "equilibrium_thermodynamics" }, "population_status": { "const": "populated_in_this_registry" } } },
        { "properties": { "category_id": { "const": "kinetics" }, "section_id": { "const": null }, "population_status": { "const": "placeholder_future_category" } } },
        { "properties": { "category_id": { "const": "kinematics" }, "section_id": { "const": null }, "population_status": { "const": "placeholder_future_category" } } },
        { "properties": { "category_id": { "const": "weather_dynamics" }, "section_id": { "const": null }, "population_status": { "const": "placeholder_future_category" } } }
      ]
    },
    "instrumentation_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_path", "status", "inclusion", "scope", "structural_descriptors_retained"],
      "properties": {
        "registry_id": { "const": "mechanics_instrumentation_registry" },
        "registry_path": { "const": "schemas/mechanics_instrumentation_registry.yaml" },
        "status": { "const": "future_separate_registry" },
        "inclusion": { "const": "excluded_from_this_registry" },
        "scope": { "const": "facilities_and_computational_simulation_models" },
        "structural_descriptors_retained": { "const": ["two_temperature_model", "multi_temperature_model"] }
      }
    },
    "rich_glossary_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanic_id", "definition", "relation_type", "value", "phenomenon_class", "source_class"],
      "properties": {
        "mechanic_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "definition": { "type": "string", "minLength": 1 },
        "relation_type": { "enum": ["activated_by", "resists_by", "distributes", "constrains", "exchanges", "absorbs", "repels", "fixes", "transduces", "characterizes", "transforms", "structures", "transfers"] },
        "value": { "type": "string", "minLength": 1 },
        "phenomenon_class": { "enum": ["capability_action", "high_enthalpy", "high_entropy", "low_enthalpy", "low_entropy", "equilibrium"] },
        "semantic_transition": { "const": "failure_or_crossover" },
        "source_class": { "const": "authored_capability" }
      }
    },
    "capability_entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rich_glossary_entry" }
    },
    "polarity_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polarity_bit", "zodiac", "zodiac_facet_ref", "transition_ref"],
      "properties": {
        "polarity_bit": { "type": "integer", "enum": [0, 1] },
        "zodiac": { "enum": ["Aries", "Scorpio", "Sagittarius", "Pisces", "Libra", "Taurus", "Aquarius", "Capricorn"] },
        "zodiac_facet_ref": { "type": "string", "pattern": "^fivefold\\.zodiac\\.[a-z_.]+$" },
        "transition_ref": { "type": "string", "pattern": "^court_(advance|retreat)_C[0-4]_to_C[0-4]$" }
      }
    },
    "binary_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["electric_external", "magnetic_internal"],
      "properties": {
        "electric_external": { "$ref": "#/$defs/capability_entries" },
        "magnetic_internal": { "$ref": "#/$defs/capability_entries" }
      }
    },
    "polar_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "governor", "school_ref", "scale_id", "scale_map_ref", "transition_refs", "polarity_bindings", "capabilities"],
      "properties": {
        "element": { "enum": ["Fire", "Air", "Water", "Earth"] },
        "governor": { "enum": ["Mars", "Jupiter", "Venus", "Saturn"] },
        "school_ref": { "type": "string", "pattern": "^fivefold\\.capability_school\\.[a-z_]+$" },
        "scale_id": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "scale_map_ref": { "type": "string", "minLength": 1 },
        "transition_refs": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^court_(advance|retreat)_C[0-4]_to_C[0-4]$" } },
        "polarity_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["electric_external", "magnetic_internal"],
          "properties": {
            "electric_external": { "$ref": "#/$defs/polarity_binding" },
            "magnetic_internal": { "$ref": "#/$defs/polarity_binding" }
          }
        },
        "capabilities": { "$ref": "#/$defs/binary_capabilities" }
      }
    },
    "fire_element": {
      "allOf": [
        { "$ref": "#/$defs/polar_element" },
        { "properties": { "element": { "const": "Fire" }, "governor": { "const": "Mars" }, "scale_id": { "const": 661 }, "school_ref": { "const": "fivefold.capability_school.fire" }, "scale_map_ref": { "const": "schemas/elemental_pentatonic_scale_map_v1.0.0.yaml#scale_bindings[Fire (Mars)]" }, "transition_refs": { "const": ["court_advance_C0_to_C1", "court_retreat_C1_to_C0"] }, "polarity_bindings": { "$ref": "#/$defs/fire_bindings" } } }
      ]
    },
    "air_element": {
      "allOf": [
        { "$ref": "#/$defs/polar_element" },
        { "properties": { "element": { "const": "Air" }, "governor": { "const": "Jupiter" }, "scale_id": { "const": 677 }, "school_ref": { "const": "fivefold.capability_school.air" }, "scale_map_ref": { "const": "schemas/elemental_pentatonic_scale_map_v1.0.0.yaml#scale_bindings[Air / Wind (Jupiter)]" }, "transition_refs": { "const": ["court_advance_C1_to_C2", "court_retreat_C2_to_C1"] }, "polarity_bindings": { "$ref": "#/$defs/air_bindings" } } }
      ]
    },
    "water_element": {
      "allOf": [
        { "$ref": "#/$defs/polar_element" },
        { "properties": { "element": { "const": "Water" }, "governor": { "const": "Venus" }, "scale_id": { "const": 1193 }, "school_ref": { "const": "fivefold.capability_school.water" }, "scale_map_ref": { "const": "schemas/elemental_pentatonic_scale_map_v1.0.0.yaml#scale_bindings[Water (Venus)]" }, "transition_refs": { "const": ["court_advance_C2_to_C3", "court_retreat_C3_to_C2"] }, "polarity_bindings": { "$ref": "#/$defs/water_bindings" } } }
      ]
    },
    "earth_element": {
      "allOf": [
        { "$ref": "#/$defs/polar_element" },
        { "properties": { "element": { "const": "Earth" }, "governor": { "const": "Saturn" }, "scale_id": { "const": 1321 }, "school_ref": { "const": "fivefold.capability_school.earth" }, "scale_map_ref": { "const": "schemas/elemental_pentatonic_scale_map_v1.0.0.yaml#scale_bindings[Earth (Saturn)]" }, "transition_refs": { "const": ["court_advance_C3_to_C4", "court_retreat_C4_to_C3"] }, "polarity_bindings": { "$ref": "#/$defs/earth_bindings" } } }
      ]
    },
    "quintessence_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "governor", "school_ref", "scale_id", "scale_map_ref", "is_binary_court_pole", "court_pole_index", "register_membership", "engine_interface_ref", "capabilities"],
      "properties": {
        "element": { "const": "Quintessence" },
        "governor": { "const": "Mercury" },
        "school_ref": { "const": "fivefold.capability_school.quintessence" },
        "scale_id": { "const": 1189 },
        "scale_map_ref": { "const": "schemas/elemental_pentatonic_scale_map_v1.0.0.yaml#scale_bindings[Quintessence (Mercury)]" },
        "is_binary_court_pole": { "const": false },
        "court_pole_index": { "type": "null" },
        "register_membership": { "const": "excluded" },
        "engine_interface_ref": { "const": "mercury_engine_cycle" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_interface", "electric_external", "magnetic_internal"],
          "properties": {
            "engine_interface": { "$ref": "#/$defs/capability_entries" },
            "electric_external": { "$ref": "#/$defs/capability_entries" },
            "magnetic_internal": { "$ref": "#/$defs/capability_entries" }
          }
        }
      }
    },
    "fire_bindings": {
      "allOf": [
        { "$ref": "#/$defs/fire_or_air_or_water_or_earth_bindings" },
        { "properties": { "electric_external": { "properties": { "polarity_bit": { "const": 0 }, "zodiac": { "const": "Aries" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.aries" }, "transition_ref": { "const": "court_retreat_C1_to_C0" } } }, "magnetic_internal": { "properties": { "polarity_bit": { "const": 1 }, "zodiac": { "const": "Scorpio" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.scorpio" }, "transition_ref": { "const": "court_advance_C0_to_C1" } } } } }
      ]
    },
    "air_bindings": {
      "allOf": [
        { "$ref": "#/$defs/fire_or_air_or_water_or_earth_bindings" },
        { "properties": { "electric_external": { "properties": { "polarity_bit": { "const": 0 }, "zodiac": { "const": "Sagittarius" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.sagittarius" }, "transition_ref": { "const": "court_retreat_C2_to_C1" } } }, "magnetic_internal": { "properties": { "polarity_bit": { "const": 1 }, "zodiac": { "const": "Pisces" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.pisces" }, "transition_ref": { "const": "court_advance_C1_to_C2" } } } } }
      ]
    },
    "water_bindings": {
      "allOf": [
        { "$ref": "#/$defs/fire_or_air_or_water_or_earth_bindings" },
        { "properties": { "electric_external": { "properties": { "polarity_bit": { "const": 0 }, "zodiac": { "const": "Libra" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.libra" }, "transition_ref": { "const": "court_retreat_C3_to_C2" } } }, "magnetic_internal": { "properties": { "polarity_bit": { "const": 1 }, "zodiac": { "const": "Taurus" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.taurus" }, "transition_ref": { "const": "court_advance_C2_to_C3" } } } } }
      ]
    },
    "earth_bindings": {
      "allOf": [
        { "$ref": "#/$defs/fire_or_air_or_water_or_earth_bindings" },
        { "properties": { "electric_external": { "properties": { "polarity_bit": { "const": 0 }, "zodiac": { "const": "Aquarius" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.aquarius" }, "transition_ref": { "const": "court_retreat_C4_to_C3" } } }, "magnetic_internal": { "properties": { "polarity_bit": { "const": 1 }, "zodiac": { "const": "Capricorn" }, "zodiac_facet_ref": { "const": "fivefold.zodiac.capability_school_facet.capricorn" }, "transition_ref": { "const": "court_advance_C3_to_C4" } } } } }
      ]
    },
    "fire_or_air_or_water_or_earth_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["electric_external", "magnetic_internal"],
      "properties": {
        "electric_external": { "$ref": "#/$defs/polarity_binding" },
        "magnetic_internal": { "$ref": "#/$defs/polarity_binding" }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard_id", "status", "statement"],
      "properties": {
        "guard_id": { "type": "string", "minLength": 1 },
        "status": { "const": "enforced" },
        "statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
