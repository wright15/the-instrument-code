{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/court-filter-algebra/0.1.0/schemas/non-commutation-records.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "integratedAdmission", "sourceFingerprint", "filterAlgebraFingerprint", "recordCount", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "releaseId": { "const": "court-filter-algebra:0.1.0" }, "integratedAdmission": { "const": "proposed_pending_crt_309" },
    "sourceFingerprint": { "$ref": "common.schema.json#/$defs/sha256" }, "filterAlgebraFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "recordCount": { "const": 23814 },
    "records": { "type": "array", "minItems": 23814, "maxItems": 23814, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["recordId", "filterId", "filterMask", "operatorId", "sourceState", "targetState", "leftResult", "rightUndefinedReason", "routeSemanticsNote", "ledgerDeclaration"],
      "properties": {
        "recordId": { "type": "string", "pattern": "^noncomm:" }, "filterId": { "type": "string", "pattern": "^court-filter:" }, "filterMask": { "type": "integer", "minimum": 0, "maximum": 4095 }, "operatorId": { "type": "string", "pattern": "^(M|[RL][1-7])$" },
        "sourceState": { "$ref": "common.schema.json#/$defs/state" }, "targetState": { "$ref": "common.schema.json#/$defs/state" },
        "leftResult": { "type": "object", "additionalProperties": false, "required": ["route", "outputMask", "pitchClasses"], "properties": { "route": { "const": "P_c(T(x))" }, "outputMask": { "type": "integer", "minimum": 0, "maximum": 4095 }, "pitchClasses": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 11 } } } },
        "rightUndefinedReason": { "const": "mutation_domain_not_rooted_weight_seven" }, "routeSemanticsNote": { "type": "string", "minLength": 1 },
        "ledgerDeclaration": { "type": "object", "additionalProperties": false, "required": ["namespace", "runtimeEventRequired", "eventPointer"], "properties": { "namespace": { "const": "court.routeSemantics" }, "runtimeEventRequired": { "const": true }, "eventPointer": { "type": "null" } } }
      }
    }
  }
}
