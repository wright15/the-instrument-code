{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/court-filter-algebra/0.1.0/schemas/commutation-table.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "integratedAdmission", "sourceFingerprint", "filterAlgebraFingerprint", "operandLedgerPath", "operandCount", "filterCount", "mutationOperatorCount", "evaluationCount", "summaryRowCount", "classificationTotals", "rows"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "releaseId": { "const": "court-filter-algebra:0.1.0" }, "integratedAdmission": { "const": "proposed_pending_crt_309" },
    "sourceFingerprint": { "$ref": "common.schema.json#/$defs/sha256" }, "filterAlgebraFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "operandLedgerPath": { "const": "canonical/universal-heptatonic-ledger.json" }, "operandCount": { "const": 462 }, "filterCount": { "const": 7 }, "mutationOperatorCount": { "const": 15 }, "evaluationCount": { "const": 48510 }, "summaryRowCount": { "const": 105 },
    "classificationTotals": { "$ref": "common.schema.json#/$defs/classificationCounts" },
    "rows": { "type": "array", "minItems": 105, "maxItems": 105, "items": { "type": "object", "additionalProperties": false, "required": ["filterId", "filterMask", "operatorId", "operandCount", "classificationCounts"], "properties": { "filterId": { "type": "string", "pattern": "^court-filter:" }, "filterMask": { "type": "integer", "minimum": 0, "maximum": 4095 }, "operatorId": { "pattern": "^(M|[RL][1-7])$" }, "operandCount": { "const": 462 }, "classificationCounts": { "$ref": "common.schema.json#/$defs/classificationCounts" } } } }
  }
}
