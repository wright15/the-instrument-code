{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/gov-206/graph-snapshot.schema.json",
  "title": "GOV-206 Deterministic Graph Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","projectionId","projectionFingerprint","sourceFingerprint","policyFingerprint","classificationResultFingerprints","runtimeSnapshotFingerprints","nodes","edges","counts"],
  "properties": {
    "schemaVersion": { "const": "gov-206.graph-snapshot.v1" },
    "projectionId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "projectionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "classificationResultFingerprints": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "runtimeSnapshotFingerprints": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "nodes": { "type": "array", "maxItems": 10000, "items": { "type": "object", "required": ["logicalId","label","projectionFingerprint","sourceFingerprint","policyFingerprint","recordSha256","admissionStatus","verificationStatus","properties"], "additionalProperties": false, "properties": { "logicalId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }, "label": { "enum": ["GovRuntimePolicyRelease","GovTypedAspect","GovBridgeRule","GovClassificationEvidence","GovLedgerSnapshot","GovGovernorProfileView","GovLegalMoveView","GovProvenanceSource","GovGovernorReference"] }, "projectionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "admissionStatus": { "enum": ["unresolved","proposed","fixture_supported","provisionally_admitted","canonical","not_applicable"] }, "verificationStatus": { "enum": ["verified","unverified","not_applicable"] }, "properties": { "type": "object" } } } },
    "edges": { "type": "array", "maxItems": 50000, "items": { "type": "object", "required": ["logicalId","relationshipType","sourceLogicalId","sourceLabel","targetLogicalId","targetLabel","projectionFingerprint","sourceFingerprint","policyFingerprint","recordSha256","admissionStatus","verificationStatus","properties"], "additionalProperties": false, "properties": { "logicalId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }, "relationshipType": { "enum": ["GOV_DECLARES_ASPECT","GOV_DECLARES_RULE","GOV_RULE_OUTPUT","GOV_SUPPORTED_BY","GOV_DERIVED_FROM_SOURCE","GOV_SNAPSHOT_HAS_MOVE","GOV_REFERENCES_GOVERNOR"] }, "sourceLogicalId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }, "sourceLabel": { "enum": ["GovRuntimePolicyRelease","GovTypedAspect","GovBridgeRule","GovClassificationEvidence","GovLedgerSnapshot","GovGovernorProfileView","GovLegalMoveView","GovProvenanceSource","GovGovernorReference"] }, "targetLogicalId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }, "targetLabel": { "enum": ["GovRuntimePolicyRelease","GovTypedAspect","GovBridgeRule","GovClassificationEvidence","GovLedgerSnapshot","GovGovernorProfileView","GovLegalMoveView","GovProvenanceSource","GovGovernorReference"] }, "projectionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "recordSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "admissionStatus": { "enum": ["unresolved","proposed","fixture_supported","provisionally_admitted","canonical","not_applicable"] }, "verificationStatus": { "enum": ["verified","unverified","not_applicable"] }, "properties": { "type": "object" } } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["nodeCount","edgeCount","byLabel","byRelationship"], "properties": { "nodeCount": { "type": "integer", "minimum": 0, "maximum": 10000 }, "edgeCount": { "type": "integer", "minimum": 0, "maximum": 50000 }, "byLabel": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "byRelationship": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } }
  },
  "not": { "anyOf": [ { "required": ["office"] }, { "required": ["occupiesOffice"] }, { "required": ["degreeGovernor"] }, { "required": ["neo4jId"] }, { "required": ["validationToken"] }, { "required": ["tokenId"] }, { "required": ["authorizationToken"] } ] }
}