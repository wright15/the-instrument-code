{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/court-substrate/0.1.0/schemas/bridge-rooting.schema.json",
  "title": "BridgeRooting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridgeRootingId",
    "setClassId",
    "rootPc",
    "pitchClasses",
    "pitchMask",
    "pitchMask12",
    "sourceScaleStateId",
    "targetScaleStateId",
    "t5Reference",
    "rawComplementMask",
    "normalizedComplementScaleStateId",
    "complementFamilyId",
    "admissionStatus"
  ],
  "properties": {
    "bridgeRootingId": { "type": "string", "minLength": 1 },
    "setClassId": { "enum": ["pentatonic:5-23", "pentatonic:5-27"] },
    "rootPc": { "const": 0 },
    "pitchClasses": { "$ref": "common.schema.json#/$defs/pitchClasses" },
    "pitchMask": { "type": "integer", "minimum": 1, "maximum": 4095 },
    "pitchMask12": { "$ref": "common.schema.json#/$defs/mask12" },
    "sourceScaleStateId": { "const": 1453 },
    "targetScaleStateId": { "const": 2477 },
    "t5Reference": { "$ref": "common.schema.json#/$defs/t5Reference" },
    "rawComplementMask": { "type": "integer", "minimum": 1, "maximum": 4095 },
    "normalizedComplementScaleStateId": { "type": "integer", "minimum": 1, "maximum": 4095 },
    "complementFamilyId": { "type": "string", "pattern": "^7-(?:Z)?[0-9]+$" },
    "admissionStatus": { "const": "admitted-bridge" }
  }
}
