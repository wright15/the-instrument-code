{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/schemas/canonical-profile.schema.json",
  "title": "Seven Governors Canonical Profile Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryVersion",
    "releaseId",
    "profileCount",
    "officeOrder",
    "profiles"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "registryVersion": { "type": "string" },
    "releaseId": {
      "type": "string",
      "pattern": "^canonical-profile-registry:"
    },
    "profileCount": { "const": 7 },
    "officeOrder": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "profiles": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "profileId",
        "profileVersion",
        "releaseId",
        "office",
        "officeIndex",
        "canonicalIdentity",
        "physical",
        "harmonic",
        "semantic",
        "domainReferences",
        "featureAssertions",
        "provenance",
        "intrinsicFingerprint"
      ],
      "properties": {
        "profileId": { "type": "string", "pattern": "^profile:" },
        "profileVersion": { "type": "string" },
        "releaseId": {
          "type": "string",
          "pattern": "^canonical-profile-registry:"
        },
        "office": { "type": "string" },
        "officeIndex": { "type": "integer", "minimum": 0, "maximum": 6 },
        "canonicalIdentity": {
          "type": "object",
          "required": [
            "stateId",
            "stateName",
            "mode",
            "forteFamily",
            "pitchMask",
            "anchorTier"
          ]
        },
        "physical": {
          "type": "object",
          "required": [
            "photonicId",
            "wavelengthNm",
            "interpretationPolicy"
          ]
        },
        "harmonic": {
          "type": "object",
          "required": [
            "stateGovernor",
            "canonicalMode",
            "canonicalStateId",
            "harmonicCompression"
          ]
        },
        "semantic": {
          "type": "object",
          "required": [
            "thermodynamicFunction",
            "opticalFunction",
            "directionality",
            "semanticCompression"
          ],
          "properties": {
            "semanticCompression": {
              "type": "object",
              "required": [
                "coordinateSymbol",
                "status",
                "orderedPosition",
                "orderedProcess",
                "normalizedOrdinal",
                "metric",
                "physicalClaim"
              ],
              "properties": {
                "orderedPosition": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "normalizedOrdinal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "metric": { "const": false },
                "physicalClaim": { "const": false }
              }
            }
          }
        },
        "domainReferences": {
          "type": "object",
          "required": ["landforms"]
        },
        "featureAssertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["featureId", "value", "provenance"]
          }
        },
        "intrinsicFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
