{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/crt-307/schemas/inspect-court-state.schema.json",
  "title": "CRT-307 inspect_court_state facade contracts",
  "oneOf": [{"$ref": "#/$defs/input"}, {"$ref": "#/$defs/output"}],
  "$defs": {
    "input": {
      "$id": "crt-307.inspect-court-state.input.v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "sessionId"],
      "properties": {
        "schemaVersion": {"const": "crt-307.inspect-court-state.input.v1"},
        "requestId": {"$ref": "common.schema.json#/$defs/identifier"},
        "sessionId": {"$ref": "common.schema.json#/$defs/identifier"},
        "expectedStateSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "includeGraphContext": {"type": "boolean"},
        "eventLimit": {"type": "integer", "minimum": 1, "maximum": 25}
      }
    },
    "output": {
      "$id": "crt-307.inspect-court-state.output.v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "skillId", "requestId", "status", "reasonCode", "directive", "state", "replay", "graph", "menu", "toolReceipts", "resultFingerprint"],
      "properties": {
        "schemaVersion": {"const": "crt-307.inspect-court-state.output.v1"},
        "skillId": {"const": "inspect_court_state"},
        "requestId": {"$ref": "common.schema.json#/$defs/identifier"},
        "status": {"enum": ["ok", "rejected", "unavailable", "denied", "reinspect"]},
        "reasonCode": {"$ref": "common.schema.json#/$defs/identifier"},
        "directive": {"$ref": "common.schema.json#/$defs/directive"},
        "state": {"$ref": "common.schema.json#/$defs/nullableStateRef"},
        "replay": {"$ref": "common.schema.json#/$defs/replaySummary"},
        "graph": {"$ref": "common.schema.json#/$defs/nullableGraphContext"},
        "menu": {"$ref": "common.schema.json#/$defs/nullableMenu"},
        "toolReceipts": {"$ref": "common.schema.json#/$defs/toolReceipts"},
        "resultFingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
