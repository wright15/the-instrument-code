{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/crt-307/schemas/install-manifest.schema.json",
  "title": "CRT-307 deterministic install manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "bundleVersion", "adapterId", "adapterVersion", "sourceFingerprint", "registrySha256", "files", "aggregateFingerprint"],
  "properties": {
    "schemaVersion": {"const": "crt-307.install-manifest.v1"},
    "bundleId": {"const": "seven-governors-crt-307"},
    "bundleVersion": {"const": "1.0.0"},
    "adapterId": {"enum": ["generic-json", "hermes"]},
    "adapterVersion": {"const": "1.0.0"},
    "sourceFingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "registrySha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "files": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/file"}},
    "aggregateFingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
