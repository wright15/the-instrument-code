  "forbidden": {
    "tools": ["raw_cypher", "raw_shell"],
    "operations": ["court.graph.write", "court.ledger.write", "court.position.write", "court.token.issue", "court.success.from_prose", "court.kappa.cross_namespace.write", "topology.write", "governor.write"],
