{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seven-governors.local/gov-207/schemas/install-manifest.schema.json",
  "title": "GOV-207 Deterministic Install Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "bundleVersion",
    "adapterId",
    "adapterVersion",
    "sourceFingerprint",
    "registrySha256",
    "files",
    "aggregateFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": "gov-207.install-manifest.v1" },
    "bundleId": { "const": "seven-governors-gov-207" },
    "bundleVersion": { "const": "1.0.0" },
    "adapterId": { "enum": ["generic-json", "hermes"] },
    "adapterVersion": { "const": "1.0.0" },
    "sourceFingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "registrySha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/file" }
    },
    "aggregateFingerprint": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
