# Secrets — never commit real credentials
.env

# Dependencies (matches at any depth)
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Node / build tooling
*.log
npm-debug.log*
.yarn/*
